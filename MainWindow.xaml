<Window x:Class="XIslandFluent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:XIslandFluent.Models"
        Title="X 岛" Width="1280" Height="820" MinWidth="920" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource SurfaceBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <DataTemplate x:Key="ThreadCardTemplate" DataType="{x:Type models:Post}">
            <Border Style="{StaticResource CardStyle}" Cursor="Hand" MouseLeftButtonUp="ThreadCard_Click" Tag="{Binding Id}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <DockPanel LastChildFill="True">
                            <Border Background="#140067C0" CornerRadius="4" Padding="6,2" DockPanel.Dock="Left" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Id, StringFormat=No.{0}}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                            </Border>
                            <TextBlock Text="{Binding DisplayTitle}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding CleanContent}" Margin="0,9,0,10" MaxHeight="78" TextTrimming="CharacterEllipsis" LineHeight="22"/>
                        <DockPanel>
                            <TextBlock Text="{Binding Author}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="14,0,0,0"/>
                            <TextBlock Text="{Binding ReplyCount, StringFormat={}{0} 条回复}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="14,0,0,0"/>
                        </DockPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="112" Height="82" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource LayerBrush}"
                            Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}">
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ReplyCardTemplate" DataType="{x:Type models:Post}">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding Id, StringFormat=No.{0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Author}" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,0,0" FontSize="12"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FluentButton}" Padding="9,3" MinHeight="26" Content="保存图片" Tag="{Binding}" Click="SaveImage_Click" Margin="6,0,0,0"
                                Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FluentButton}" Padding="9,3" MinHeight="26" Content="引用" Tag="{Binding}" Click="Quote_Click"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FluentButton}" Padding="9,3" MinHeight="26" Content="查看引用" Tag="{Binding Id}" Click="Reference_Click" Margin="0,0,6,0"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CleanContent}" Margin="0,10,0,0" LineHeight="22" TextWrapping="Wrap"/>
                    <Border Margin="0,12,0,0" MaxWidth="720" MaxHeight="520" HorizontalAlignment="Left" CornerRadius="6" ClipToBounds="True"
                            Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}">
                        <Image Source="{Binding ImageUrl}" Stretch="Uniform"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:ForumCategory}" ItemsSource="{Binding Forums}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,5"/>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:ForumInfo}">
            <TextBlock Text="{Binding Name}" Margin="2,5"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Background="{DynamicResource AccentBrush}" Width="28" Height="28" CornerRadius="7">
                        <TextBlock Text="X" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="X 岛" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TitleBarText" Text="时间线" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"/>
                <Grid Grid.Column="2" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource FluentButton}" BorderThickness="0" Padding="0" Content="—" Click="Minimize_Click"/>
                    <Button Grid.Column="1" Style="{StaticResource FluentButton}" BorderThickness="0" Padding="0" Content="□" Click="Maximize_Click"/>
                    <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource FluentButton}" BorderThickness="0" Padding="0" Content="✕" Click="Close_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button Style="{StaticResource AccentButton}" HorizontalContentAlignment="Left" Margin="0,4,0,8" Click="Search_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="搜索全岛"/></StackPanel></Button>
                    <TextBox Grid.Row="1" x:Name="QuickOpenBox" ToolTip="输入串号并按 Enter" KeyDown="QuickOpenBox_KeyDown" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource FluentButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="TimelineNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="时间线"/></StackPanel></Button>
                        <Button Style="{StaticResource FluentButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="ForumsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="浏览板块"/></StackPanel></Button>
                        <Button Style="{StaticResource FluentButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="FeedNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="我的订阅"/></StackPanel></Button>
                        <Button Style="{StaticResource FluentButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="OfflineNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="离线缓存"/></StackPanel></Button>
                        <Button Style="{StaticResource FluentButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="NoticeNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="公告"/></StackPanel></Button>
                    </StackPanel>
                    <Button Grid.Row="3" Style="{StaticResource FluentButton}" HorizontalContentAlignment="Left" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="设置"/></StackPanel></Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Background="#08FFFFFF">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="时间线" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSubtitle" Text="来自全岛的最新内容" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackButton" Style="{StaticResource FluentButton}" Content="返回" Click="Back_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource FluentButton}" Content="刷新" Click="Refresh_Click" Margin="0,0,8,0"/>
                            <Button x:Name="NewThreadButton" Style="{StaticResource AccentButton}" Content="发新串" Click="NewThread_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" x:Name="StatusBar" Background="#120067C0" Padding="24,9" Visibility="Collapsed">
                    <DockPanel><ProgressBar x:Name="BusyIndicator" Width="90" Height="3" IsIndeterminate="True" DockPanel.Dock="Right"/><TextBlock x:Name="StatusText" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
                </Border>

                <Grid Grid.Row="2" Margin="24,18,24,20">
                    <Grid x:Name="ListViewPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ComboBox x:Name="TimelinePicker" Width="240" HorizontalAlignment="Left" SelectionChanged="TimelinePicker_SelectionChanged" Margin="0,0,0,12" DisplayMemberPath="DisplayName"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ThreadItems" ItemTemplate="{StaticResource ThreadCardTemplate}"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Style="{StaticResource FluentButton}" Content="上一页" Click="PreviousPage_Click" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PageNumberText" Text="第 1 页" VerticalAlignment="Center" Margin="8,0"/>
                            <Button Style="{StaticResource FluentButton}" Content="下一页" Click="NextPage_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ForumsPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <TreeView x:Name="ForumTree" ItemsSource="{Binding ForumCategories}" SelectedItemChanged="ForumTree_SelectedItemChanged" Background="Transparent" BorderThickness="0"/>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock x:Name="ForumDetailName" Text="选择一个板块" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ForumDetailDescription" Text="从左侧列表选择板块后即可浏览。" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,8,0,18"/>
                                <Button x:Name="OpenForumButton" Style="{StaticResource AccentButton}" Content="打开板块" Click="OpenForum_Click" HorizontalAlignment="Left" IsEnabled="False"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ThreadPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox x:Name="OnlyPoCheck" Content="只看 PO" Checked="OnlyPoCheck_Changed" Unchecked="OnlyPoCheck_Changed"/>
                            <Button x:Name="SubscribeButton" Style="{StaticResource FluentButton}" Padding="10,4" MinHeight="28" Content="订阅此串" Click="SubscribeCurrent_Click" Margin="12,0,0,0"/>
                            <Button x:Name="UnsubscribeButton" Style="{StaticResource FluentButton}" Padding="10,4" MinHeight="28" Content="取消订阅" Click="UnsubscribeCurrent_Click" Margin="6,0,0,0"/>
                            <Button x:Name="CacheThreadButton" Style="{StaticResource FluentButton}" Padding="10,4" MinHeight="28" Content="缓存此串" Click="CacheCurrentThread_Click" Margin="6,0,0,0"/>
                            <TextBlock x:Name="OfflineModeText" Text="离线阅读" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Style="{StaticResource FluentButton}" Padding="10,4" MinHeight="28" Content="上一页" Click="PreviousPage_Click" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ElementName=PageNumberText, Path=Text}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                                <Button Style="{StaticResource FluentButton}" Padding="10,4" MinHeight="28" Content="下一页" Click="NextPage_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ReplyItems" ItemTemplate="{StaticResource ReplyCardTemplate}"/></ScrollViewer>
                        <Grid x:Name="ReplyComposer" Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ReplyBox" AcceptsReturn="True" MinHeight="58" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
                            <Button Grid.Column="1" Style="{StaticResource FluentButton}" Content="添加图片" Click="ChooseReplyImage_Click" Margin="8,0"/>
                            <Button x:Name="SendReplyButton" Grid.Column="2" Style="{StaticResource AccentButton}" Content="发送回复" Click="SendReply_Click"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="OfflinePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource AccentButton}" Content="导入缓存" Click="ImportOffline_Click"/>
                            <Button Style="{StaticResource FluentButton}" Content="刷新列表" Click="RefreshOffline_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" x:Name="OfflineItems" DisplayMemberPath="DisplayText" Background="Transparent" BorderThickness="0" FontSize="14"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="打开缓存" Click="OpenOffline_Click"/>
                            <Button Style="{StaticResource FluentButton}" Content="导出选中" Click="ExportOffline_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="身份与订阅" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="订阅标识仅用于同步订阅列表；饼干用于访问受限板块和发表内容。数据只保存在本机。" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,5,0,14"/><TextBlock Text="订阅标识"/><TextBox x:Name="SubscriptionIdBox" Margin="0,5,0,12"/><TextBlock Text="Cookie / 饼干"/><PasswordBox x:Name="CookieBox" Margin="0,5,0,10" ToolTip="饼干值已隐藏；也可以手动粘贴完整 Cookie 字符串"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource AccentButton}" Content="从用户系统获取饼干" Click="ImportCookie_Click"/><TextBlock x:Name="CookieStatusText" Text="尚未获取" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></StackPanel></Border>
                                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="外观与发图" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="主题" Margin="0,12,0,4"/><ComboBox x:Name="ThemePicker" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox><CheckBox x:Name="WatermarkCheck" Content="上传图片时添加水印" Margin="0,12,0,0"/></StackPanel></Border>
                                <Button Style="{StaticResource AccentButton}" Content="保存设置" Click="SaveSettings_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="NoticePanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}" Margin="0" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel><TextBlock Text="站点公告" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="NoticeText" Text="正在获取公告…" Margin="0,16,0,0" LineHeight="23"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
