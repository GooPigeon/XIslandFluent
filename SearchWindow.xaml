<Window x:Class="XIslandFluent.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="X 岛搜索" Width="1080" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FluentButton}" Content="重新加载" Click="Reload_Click"/>
                <StackPanel><TextBlock Text="搜索 X 岛" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="点击搜索结果中的串，将自动回到客户端打开。" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
        <Border Grid.Row="2" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource FluentButton}" Content="关闭" Click="Close_Click"/><TextBlock x:Name="StatusText" Text="正在打开搜索…" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"/></DockPanel>
        </Border>
    </Grid>
</Window>
